<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:A11yAgent.Desktop.ViewModels"
        xmlns:m="using:A11yAgent.Desktop.Models"
        xmlns:svc="using:A11yAgent.Desktop.Services"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="A11yAgent.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Uirapuru — assistente acessível"
        Icon="/Assets/uirapuru.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorations="BorderOnly"
        Width="1360" Height="860"
        MinWidth="1000" MinHeight="660"
        Background="{DynamicResource Nevoa}"
        Foreground="{DynamicResource Texto}"
        FontSize="16">

  <Design.DataContext>
    <vm:MainViewModel/>
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding PickWorkspaceCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
  </Window.KeyBindings>

  <Window.Styles>
    <!-- ===== Texto ===== -->
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Texto3}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Rótulos de seção da barra lateral -->
    <Style Selector="TextBlock.rotulo">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto2}"/>
    </Style>
    <Style Selector="Border.tecla">
      <Setter Property="Background" Value="{DynamicResource Nevoa}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Linha}"/>
      <Setter Property="BorderThickness" Value="1,1,1,2"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,2"/>
    </Style>
    <Style Selector="Border.tecla > TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto2}"/>
    </Style>

    <!-- ===== Botões: alvo mínimo de 44 px ===== -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <!-- Ação principal: ferrugem do uirapuru (branco sobre #B44A12 = 5,2:1) -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Acao}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AcaoHover}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource Folha}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Texto3}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter, Button.secondary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selecao}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Texto3}"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto2}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="Button.idea">
      <Setter Property="Background" Value="{DynamicResource Folha}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Linha}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style Selector="Button.idea:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Folha}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Texto3}"/>
    </Style>

    <!-- ===== Barra lateral (mata de igapó) ===== -->
    <Style Selector="Button.nova">
      <Setter Property="Background" Value="{DynamicResource Garganta}"/>
      <Setter Property="Foreground" Value="{DynamicResource Mata}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.nova:pointerover /template/ ContentPresenter, Button.nova:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GargantaHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource Mata}"/>
    </Style>
    <Style Selector="Button.contorno">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MataTexto2}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.contorno:pointerover /template/ ContentPresenter, Button.contorno:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MataSel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MataTexto2}"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
    </Style>
    <Style Selector="Button.icone-lateral">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinWidth" Value="44"/>
    </Style>
    <Style Selector="Button.icone-lateral:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MataSel}"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
    </Style>
    <!-- Cartão "Modelo de IA" na barra escura (texto #F3E9DC sobre #33251A = 12,9:1) -->
    <Style Selector="Button.modelo">
      <Setter Property="Background" Value="{DynamicResource MataSel}"/>
      <Setter Property="BorderBrush" Value="#5A4434"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.modelo:pointerover /template/ ContentPresenter, Button.modelo:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#3F2E21"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Garganta}"/>
    </Style>

    <!-- Tela "Modelo de IA": cada etapa é um cartão numerado -->
    <Style Selector="Border.etapa">
      <Setter Property="Background" Value="{DynamicResource Folha}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Linha}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22,20"/>
    </Style>
    <Style Selector="Border.numero">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="Background" Value="{DynamicResource Acao}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.numero > TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.em-uso">
      <Setter Property="Background" Value="{DynamicResource Nevoa}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Linha}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="8,8,18,8"/>
      <Setter Property="MinWidth" Value="220"/>
    </Style>
    <!-- Listas de escolha: cartões; o marcado ganha fundo e borda ferrugem (não depende só da cor: a borda engrossa) -->
    <Style Selector="ListBox.escolha">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.escolha ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource Folha}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Linha}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>
    <Style Selector="ListBox.escolha ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Nevoa}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Texto3}"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>
    <Style Selector="ListBox.escolha ListBoxItem:selected /template/ ContentPresenter, ListBox.escolha ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.escolha ListBoxItem:selected:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selecao}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Acao}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>
    <!-- Etiqueta LOCAL (verde #1F6B4F sobre #E3F0E9 = 5,6:1) / NUVEM (ferrugem #8A3B12 sobre #F6E2D2 = 6,6:1) -->
    <Style Selector="Border.etiqueta">
      <Setter Property="Background" Value="{DynamicResource Selecao}"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="Border.etiqueta > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AcaoTexto}"/>
    </Style>
    <Style Selector="Border.etiqueta.local">
      <Setter Property="Background" Value="{DynamicResource FolhaNovaSuave}"/>
    </Style>
    <Style Selector="Border.etiqueta.local > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FolhaNova}"/>
    </Style>
    <!-- Cartão da pasta: só cresce quando tem lista de arquivos -->
    <Style Selector="Border.pasta">
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.pasta.cheia">
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <!-- Botões da barra de título (46×44, como os do Windows; fechar fica vermelho no hover) -->
    <Style Selector="Button.legenda">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.legenda:pointerover /template/ ContentPresenter, Button.legenda:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MataSel}"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
    </Style>
    <Style Selector="Button.legenda.fechar:pointerover /template/ ContentPresenter, Button.legenda.fechar:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.legenda.fechar:pointerover, Button.legenda.fechar:pressed">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="ListBox#FileList ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style Selector="ListBox#FileList ListBoxItem:pointerover /template/ ContentPresenter, ListBox#FileList ListBoxItem:selected /template/ ContentPresenter, ListBox#FileList ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox#FileList ListBoxItem:selected:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MataSel}"/>
      <Setter Property="Foreground" Value="{DynamicResource MataTexto}"/>
    </Style>

    <!--
      Caixa de pedido e prévia: as cores de foco/hover do tema Fluent vêm de recursos
      (TextControl*), então elas são trocadas nos Resources de cada TextBox, logo abaixo no layout.
    -->

    <!-- ===== Conversa ===== -->
    <Style Selector="ListBox#ChatList ListBoxItem">
      <Setter Property="Padding" Value="0,0,0,14"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox#ChatList ListBoxItem:selected /template/ ContentPresenter, ListBox#ChatList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Background" Value="{DynamicResource Folha}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Linha}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="Background" Value="{DynamicResource Selecao}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Selecao}"/>
      <Setter Property="CornerRadius" Value="14,14,4,14"/>
      <Setter Property="Margin" Value="120,0,0,0"/>
    </Style>
    <Style Selector="Border.bubble.error">
      <Setter Property="Background" Value="{DynamicResource AcaiSuave}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AcaiBorda}"/>
    </Style>
    <!-- Ícone do passo: a cor só reforça; o estado também está no símbolo e no texto -->
    <Style Selector="TextBlock.icone">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource AcaoTexto}"/>
    </Style>
    <Style Selector="TextBlock.icone.feito"><Setter Property="Foreground" Value="{DynamicResource FolhaNova}"/></Style>
    <Style Selector="TextBlock.icone.pendente"><Setter Property="Foreground" Value="{DynamicResource Texto3}"/></Style>
    <Style Selector="TextBlock.icone.falhou"><Setter Property="Foreground" Value="{DynamicResource Acai}"/></Style>
  </Window.Styles>

  <DockPanel>

  <!--
    ================= Barra de título própria (Rio Negro, emendada com a barra lateral) =================
    O Windows continua cuidando de arrastar, clique duplo para maximizar e dos layouts de encaixe:
    cada parte diz o seu papel com chrome:WindowDecorationProperties.ElementRole.
  -->
  <Border DockPanel.Dock="Top" Classes="lateral" Height="44" Background="{DynamicResource Mata}"
          chrome:WindowDecorationProperties.ElementRole="TitleBar">
    <Grid ColumnDefinitions="272,*,Auto">
      <!-- Marca (decorativa para o leitor de tela: o título da janela já diz "Uirapuru") -->
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center"
                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Viewbox Width="26" Height="26">
              <Canvas Width="64" Height="64">
                <Rectangle Width="64" Height="64" RadiusX="16" RadiusY="16" Fill="#3A2B20"/>
                <Path Data="M22.5,36 L7,17.5 Q9,13.5 13.5,15 L26,31 Z" Fill="#8A3B12"/>
                <Ellipse Canvas.Left="15.5" Canvas.Top="28" Width="29" Height="22" Fill="#C25E1F"/>
                <Ellipse Canvas.Left="33.5" Canvas.Top="19.5" Width="17" Height="17" Fill="#C25E1F"/>
                <Path Data="M36.5,31.5 Q44,30 46.5,35.5 Q45,44 36,46 Q34,39 36.5,31.5 Z" Fill="#E9B872"/>
                <Path Data="M17.5,37 Q26,30 35,36.5 Q27,44.5 17.5,37 Z" Fill="#8A3B12"/>
                <Path Data="M49.5,26 L57.5,28.2 L49.5,30.4 Z" Fill="#E9B872"/>
                <Ellipse Canvas.Left="42.3" Canvas.Top="24.3" Width="3.8" Height="3.8" Fill="#FFFBF5"/>
                <Ellipse Canvas.Left="43.7" Canvas.Top="25.3" Width="1.8" Height="1.8" Fill="#21170F"/>
                <Path Data="M27,49.5 L25.5,56 M33,49.5 L33.5,56" Stroke="#E9B872" StrokeThickness="1.8" StrokeLineCap="Round"/>
                <Path Data="M52,18.5 V8 L58,6.5 V15" Stroke="#E9B872" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                <Ellipse Canvas.Left="48" Canvas.Top="16.3" Width="4.6" Height="4.6" Fill="#E9B872"/>
                <Ellipse Canvas.Left="54" Canvas.Top="12.9" Width="4.6" Height="4.6" Fill="#E9B872"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="Uirapuru" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource MataTexto}"/>
            <Border Background="{DynamicResource MataSel}" CornerRadius="6" Padding="7,1" VerticalAlignment="Center">
              <TextBlock Text="MANAUS" FontSize="10.5" FontWeight="Bold" LetterSpacing="1"
                         Foreground="{DynamicResource Garganta}"/>
            </Border>
      </StackPanel>

      <!-- Onde estou e como está: pasta aberta + estado do agente -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="32,0,0,0" VerticalAlignment="Center">
        <TextBlock FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource MataTexto}" FontWeight="Bold"
                   Text="{Binding WorkspaceName, StringFormat=📁  {0}}" IsVisible="{Binding HasWorkspace}"
                   AutomationProperties.Name="{Binding WorkspacePath, StringFormat=Pasta aberta: {0}}"/>
        <TextBlock FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource MataTexto2}" Text="Nenhuma pasta aberta" IsVisible="{Binding !HasWorkspace}"/>
        <Border Background="{DynamicResource MataSel}" CornerRadius="999" Padding="10,3" VerticalAlignment="Center"
                IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Garganta}"
                     Classes.off="{Binding IsOffline}">
              <Ellipse.Styles>
                <Style Selector="Ellipse.off"><Setter Property="Fill" Value="#E8A0B4"/></Style>
              </Ellipse.Styles>
            </Ellipse>
            <TextBlock Text="{Binding BadgeText}" FontSize="13" Foreground="{DynamicResource MataTexto}"
                       AutomationProperties.Name="{Binding BadgeText, StringFormat=Estado do agente: {0}}"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Botões da janela. O papel faz o Windows tratar o clique do mouse (inclui os layouts de encaixe
           do Windows 11 no maximizar); o Click atende quem usa teclado. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <!-- Tema claro/escuro: a lua leva ao escuro, o sol volta ao claro -->
        <!-- Papel User: o clique é do botão, não vira "arrastar a janela" -->
        <Button Classes="legenda" Command="{Binding ToggleThemeCommand}"
                chrome:WindowDecorationProperties.ElementRole="User"
                ToolTip.Tip="{Binding ThemeToggleText}"
                AutomationProperties.Name="{Binding ThemeToggleText}">
          <Panel>
            <Path Data="M13.5,10.5 A6,6 0 1 1 5.5,2.5 A4.8,4.8 0 0 0 13.5,10.5 Z" Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.3" StrokeJoin="Round" IsVisible="{Binding !IsDark}"/>
            <Path Data="M11,8 A3,3 0 1 1 5,8 A3,3 0 1 1 11,8 Z M8,0.5 V2.5 M8,13.5 V15.5 M0.5,8 H2.5 M13.5,8 H15.5 M2.7,2.7 L4.1,4.1 M11.9,11.9 L13.3,13.3 M2.7,13.3 L4.1,11.9 M11.9,4.1 L13.3,2.7"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" StrokeLineCap="Round"
                  IsVisible="{Binding IsDark}"/>
          </Panel>
        </Button>
        <Button Classes="legenda" Click="OnMinimizeClick" ToolTip.Tip="Minimizar"
                chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                AutomationProperties.Name="Minimizar">
          <Path Data="M0,0.5 H10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"/>
        </Button>
        <Button Classes="legenda" Click="OnMaximizeClick" ToolTip.Tip="Maximizar ou restaurar"
                chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                AutomationProperties.Name="Maximizar ou restaurar">
          <Panel>
            <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                  IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static WindowState.Maximized}}"/>
            <Path Data="M2.5,2.5 H9.5 V9.5 H2.5 Z M2.5,0.5 H11.5 V9.5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                  IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.Maximized}}"/>
          </Panel>
        </Button>
        <Button Classes="legenda fechar" Click="OnCloseClick" ToolTip.Tip="Fechar"
                chrome:WindowDecorationProperties.ElementRole="CloseButton"
                AutomationProperties.Name="Fechar">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>

  <Panel>
  <Grid ColumnDefinitions="272,*" IsVisible="{Binding !IsModelPanelOpen}">

    <!-- ================= Barra lateral (mata de igapó) ================= -->
    <Border Classes="lateral" Background="{DynamicResource Mata}" Padding="18,12,18,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="20">
          <Button Classes="nova" Content="+  Nova conversa" Command="{Binding NewConversationCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  AutomationProperties.HelpText="Limpa a conversa para começar um pedido novo"/>

          <TextBlock Classes="rotulo" Text="PASTA DE TRABALHO"/>
        </StackPanel>

        <!-- Rodapé: cartão do modelo de IA (abre a tela de escolha) -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="rotulo" Text="MODELO DE IA"/>
            <Button Name="ModelCard" Classes="modelo" IsEnabled="{Binding !IsBusy}"
                    Command="{Binding OpenModelPanelCommand}"
                    ToolTip.Tip="Trocar o provedor ou o modelo de IA"
                    AutomationProperties.Name="{Binding ActiveProvider.Name, StringFormat='Modelo de IA: {0}. Clique para trocar.'}"
                    AutomationProperties.HelpText="{Binding ModelSummary}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Mata}">
                  <TextBlock Text="{Binding ActiveProvider.Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding ActiveProvider.Name}" FontWeight="Bold" FontSize="15"
                             Foreground="{DynamicResource MataTexto}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding ModelSummary}" FontSize="13" Foreground="{DynamicResource Garganta}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModelSummary}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Trocar" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource MataTexto2}"/>
              </Grid>
            </Button>
          </StackPanel>
          <TextBlock Text="Feito em Manaus, Amazonas" FontSize="12.5" Foreground="{DynamicResource MataTexto2}"/>
        </StackPanel>

        <!-- Cartão da pasta -->
        <Border Classes="pasta" Classes.cheia="{Binding HasWorkspace}"
                BorderBrush="{DynamicResource MataSel}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,18">
          <Panel>
            <StackPanel Spacing="10" IsVisible="{Binding !HasWorkspace}">
              <TextBlock Text="Nenhuma pasta ainda" FontSize="15" Foreground="{DynamicResource MataTexto}"/>
              <TextBlock Text="É o único lugar onde eu posso mexer. Seus outros arquivos ficam seguros."
                         FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource MataTexto2}"/>
              <Button Classes="contorno" Content="Escolher pasta" Command="{Binding PickWorkspaceCommand}"
                      IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Atalho: Ctrl+O"
                      AutomationProperties.HelpText="Escolhe a pasta onde o assistente pode criar e editar arquivos. Atalho Ctrl O."/>
            </StackPanel>

            <DockPanel IsVisible="{Binding HasWorkspace}">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Text="{Binding WorkspaceName}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                           Foreground="{DynamicResource Garganta}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding WorkspacePath}"
                           AutomationProperties.Name="{Binding WorkspacePath, StringFormat=Pasta aberta: {0}}"/>
                <Button Grid.Column="1" Classes="icone-lateral" Content="⟳" FontSize="18"
                        Command="{Binding RefreshTreeCommand}" ToolTip.Tip="Atualizar lista"
                        AutomationProperties.Name="Atualizar lista de arquivos"/>
              </Grid>
              <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="Enter ou clique duplo abre o arquivo." FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource MataTexto2}"/>
                <Button Classes="contorno" Content="{Binding FolderButtonText}" Command="{Binding PickWorkspaceCommand}"
                        IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Atalho: Ctrl+O"
                        AutomationProperties.HelpText="Troca a pasta onde o assistente trabalha. Atalho Ctrl O."/>
              </StackPanel>
              <ListBox Name="FileList" ItemsSource="{Binding FileEntries}" FontSize="15"
                       Background="Transparent"
                       DoubleTapped="OnFileDoubleTapped" KeyDown="OnFileListKeyDown"
                       AutomationProperties.Name="Lista de arquivos da pasta">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Panel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ================= Área de trabalho (névoa) ================= -->
    <DockPanel Grid.Column="1">

      <!-- Status ao vivo: o leitor de tela anuncia cada mudança -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Folha}" BorderBrush="{DynamicResource Linha}"
              BorderThickness="0,0,0,1" Padding="32,14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding StatusText}"/>
            <Button Grid.Column="1" Classes="primary" Content="Tentar ligar de novo"
                    Command="{Binding CheckHealthCommand}" IsVisible="{Binding IsOffline}"
                    AutomationProperties.HelpText="Tenta ligar o assistente outra vez"/>
          </Grid>
          <ProgressBar Height="6" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                       Foreground="{DynamicResource Acao}" Background="{DynamicResource Linha}"
                       AutomationProperties.Name="Trabalhando"/>

          <!-- Ollama fechado: o que aconteceu e o que fazer, em passos -->
          <Border IsVisible="{Binding IsOllamaDown}" Background="{DynamicResource AcaiSuave}"
                  BorderBrush="{DynamicResource AcaiBorda}" BorderThickness="1" CornerRadius="12" Padding="18,14">
            <StackPanel Spacing="8">
              <TextBlock Text="⚠  O Ollama não está aberto" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Acai}"/>
              <TextBlock TextWrapping="Wrap" FontSize="15"
                         Text="O Ollama é o programa que roda a inteligência artificial no seu computador. Nada do que você escreve sai daqui."/>
              <TextBlock TextWrapping="Wrap" FontSize="15"
                         Text="1. Abra o Ollama pelo menu Iniciar.   2. Espere o ícone dele aparecer perto do relógio.   3. Clique em &quot;Tentar ligar de novo&quot;."/>
            </StackPanel>
          </Border>

          <!-- Modelo não instalado: baixa só depois do clique, com progresso -->
          <Border IsVisible="{Binding IsModelMissing}" Background="{DynamicResource AvisoSuave}"
                  BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1" CornerRadius="12" Padding="18,14">
            <StackPanel Spacing="10">
              <TextBlock TextWrapping="Wrap" FontSize="15"
                         Text="{Binding ModelToDownload, StringFormat=Falta baixar o modelo de IA {0}. São alguns gigabytes; use uma internet sem limite.}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Baixar modelo agora"
                        Command="{Binding PullModelCommand}" IsEnabled="{Binding !IsPullingModel}"
                        AutomationProperties.HelpText="Baixa o modelo pelo Ollama. Você pode cancelar com Esc."/>
                <Button Classes="secondary" Content="Cancelar download"
                        Command="{Binding CancelCommand}" IsVisible="{Binding IsPullingModel}"/>
              </StackPanel>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding PullPercent}" Height="12"
                           IsVisible="{Binding IsPullingModel}" ShowProgressText="True"
                           Foreground="{DynamicResource Acao}" Background="{DynamicResource Folha}"
                           BorderBrush="{DynamicResource Texto3}" BorderThickness="1"
                           AutomationProperties.Name="Progresso do download do modelo"/>
              <TextBlock Text="{Binding PullText}" FontSize="15" Foreground="{DynamicResource Texto2}" TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding PullText}"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Prévia (só aparece com um arquivo aberto) -->
      <Border DockPanel.Dock="Right" Width="400" IsVisible="{Binding HasPreview}"
              Background="{DynamicResource Folha}" BorderBrush="{DynamicResource Linha}" BorderThickness="1,0,0,0" Padding="20">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Prévia" FontSize="13" Foreground="{DynamicResource Texto2}"/>
              <TextBlock Text="{Binding SelectedFile}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                         FontFamily="Cascadia Mono, Consolas, monospace" ToolTip.Tip="{Binding SelectedFile}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="link" Content="✕" FontSize="18" MinWidth="44"
                    Command="{Binding ClosePreviewCommand}"
                    AutomationProperties.Name="Fechar prévia"/>
          </Grid>
          <TextBox Name="PreviewBox" Text="{Binding FileContent}"
                   AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13.5"
                   Padding="14" BorderThickness="0" CornerRadius="12"
                   Background="{DynamicResource Mata}" Foreground="{DynamicResource MataTexto}"
                   SelectionBrush="{DynamicResource MataSel}" SelectionForegroundBrush="{DynamicResource MataTexto}"
                   AutomationProperties.Name="{Binding SelectedFile, StringFormat='Conteúdo do arquivo {0} (somente leitura)'}">
            <!-- Código sobre o Rio Negro em todos os estados (texto 14,7:1) -->
            <TextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#21170F"/>
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#21170F"/>
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F3E9DC"/>
              <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F3E9DC"/>
            </TextBox.Resources>
          </TextBox>
        </DockPanel>
      </Border>

      <!-- Conversa -->
      <DockPanel Margin="40,24,40,24">
        <!-- Caixa de pedido -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Background="{DynamicResource Folha}"
                BorderBrush="{DynamicResource Texto3}" BorderThickness="1.5" CornerRadius="14" Padding="14">
          <StackPanel Spacing="12">
            <TextBox Name="PromptBox"
                     Text="{Binding PromptText}"
                     PlaceholderText="O que você quer fazer hoje? Ex.: crie uma página sobre minha loja de café"
                     PlaceholderForeground="{DynamicResource Texto3}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" MaxHeight="220"
                     FontSize="16"
                     IsEnabled="{Binding !IsBusy}"
                     Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="Seu pedido"
                     AutomationProperties.HelpText="Enter envia. Shift mais Enter pula linha.">
              <!-- O cartão em volta é a borda do campo (Texto3). O texto de exemplo opaco vem do App.axaml, por tema. -->
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
              </TextBox.Resources>
            </TextBox>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <Panel VerticalAlignment="Center">
                <Button Classes="secondary" Content="📁  Escolher pasta" HorizontalAlignment="Left"
                        Command="{Binding PickWorkspaceCommand}" IsVisible="{Binding !HasWorkspace}"
                        AutomationProperties.Name="Escolher pasta"
                        AutomationProperties.HelpText="Escolhe a pasta onde o assistente pode trabalhar. Atalho Ctrl O."/>
                <WrapPanel IsVisible="{Binding HasWorkspace}" ItemSpacing="6" LineSpacing="6"
                           AutomationProperties.Name="Atalhos: Enter envia, Shift Enter pula linha, Esc cancela, Ctrl O troca a pasta">
                  <Border Classes="tecla"><TextBlock Text="Enter envia"/></Border>
                  <Border Classes="tecla"><TextBlock Text="Shift+Enter nova linha"/></Border>
                  <Border Classes="tecla"><TextBlock Text="Esc cancela"/></Border>
                  <Border Classes="tecla"><TextBlock Text="Ctrl+O pasta"/></Border>
                </WrapPanel>
              </Panel>
              <Panel Grid.Column="1">
                <Button Classes="primary" Content="Enviar pedido" MinWidth="170"
                        Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                        IsVisible="{Binding !IsBusy}"
                        AutomationProperties.HelpText="Envia o pedido para o assistente"/>
                <Button Classes="secondary" Content="Cancelar" MinWidth="170"
                        Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"
                        AutomationProperties.HelpText="Para o trabalho do assistente. Atalho Esc."/>
              </Panel>
            </Grid>
          </StackPanel>
        </Border>

        <Panel>
          <!-- Boas-vindas (conversa vazia) -->
          <ScrollViewer IsVisible="{Binding !HasConversation}">
            <StackPanel Spacing="22" MaxWidth="820" HorizontalAlignment="Left" Margin="0,8,16,0">
              <StackPanel Spacing="6">
                <TextBlock Text="Olá! Eu sou o Uirapuru." FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock FontSize="16" Foreground="{DynamicResource Texto2}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                           Text="Diga com suas palavras o que você precisa. Eu mostro cada passo enquanto trabalho e explico tudo no final."/>
              </StackPanel>

              <TextBlock Text="Comece por uma ideia" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Texto2}"/>
              <ItemsControl ItemsSource="{Binding Examples}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExampleIdea">
                    <Button Classes="idea" Margin="0,0,10,10"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UseExampleCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title, StringFormat=Usar ideia: {0}}"
                            AutomationProperties.HelpText="{Binding Description}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource Texto}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" Classes="muted"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="muted" Text="{Binding PrivacyText}"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Mensagens -->
          <ListBox Name="ChatList" ItemsSource="{Binding Messages}"
                   IsVisible="{Binding HasConversation}"
                   Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Conversa. Use as setas para ouvir cada mensagem.">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" x:DataType="m:ChatMessage">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:ChatMessage">
                <Border Classes="bubble" Classes.user="{Binding IsUser}" Classes.error="{Binding IsError}">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <!-- "Trabalhando…" → "Pronto!" / "Não deu certo" é anunciado sem tirar o foco -->
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="17"
                                 AutomationProperties.Name="{Binding Title}"
                                 AutomationProperties.LiveSetting="{Binding TitleLiveSetting}"/>
                      <Border IsVisible="{Binding IsWorking}" Background="{DynamicResource Nevoa}" CornerRadius="999" Padding="10,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Elapsed}" FontSize="13" Foreground="{DynamicResource Texto2}"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   AutomationProperties.Name="{Binding Elapsed, StringFormat=Tempo trabalhando: {0}}"/>
                      </Border>
                    </StackPanel>

                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"
                                         LineHeight="25" IsVisible="{Binding HasText}"/>

                    <!-- Plano: ○ esperando · … fazendo · ✓ feito · ⚠ falhou -->
                    <Border IsVisible="{Binding HasPlan}" Background="{DynamicResource Nevoa}" CornerRadius="12" Padding="14,10">
                      <ItemsControl ItemsSource="{Binding Plan}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="m:ChatStep">
                            <!-- Live region: cada troca ○ → … → ✓/⚠ muda o Name e o leitor anuncia -->
                            <Grid ColumnDefinitions="30,*" Margin="0,5"
                                  AutomationProperties.AccessibilityView="Content"
                                  AutomationProperties.Name="{Binding AccessibleName}"
                                  AutomationProperties.LiveSetting="{Binding LiveSetting}">
                              <TextBlock Text="{Binding Icon}" FontSize="17" Classes="icone"
                                         Classes.feito="{Binding IsDone}" Classes.pendente="{Binding IsPending}" Classes.falhou="{Binding IsFailed}"/>
                              <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"
                                         Classes.current="{Binding IsCurrent}">
                                <TextBlock.Styles>
                                  <Style Selector="TextBlock.current"><Setter Property="FontWeight" Value="Bold"/></Style>
                                </TextBlock.Styles>
                              </TextBlock>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAwaitingApproval}">
                      <Button Classes="primary" Content="Começar"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartPlanCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.HelpText="Aprova o plano e começa a primeira etapa"/>
                      <Button Classes="secondary" Content="Descartar plano"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DiscardPlanCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.HelpText="Descarta o plano para você escrever o pedido de outro jeito"/>
                    </StackPanel>

                    <!-- Pergunta do agente: cada opção é um botão -->
                    <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:ChatOption">
                          <Button Classes="idea" Margin="0,0,8,8" HorizontalAlignment="Left"
                                  Content="{Binding Text}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ChooseOptionCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Text, StringFormat=Escolher: {0}}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Ações de arquivo ao vivo -->
                    <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:ChatStep">
                          <Grid ColumnDefinitions="26,*" Margin="0,3"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.Name="{Binding AccessibleName}"
                                AutomationProperties.LiveSetting="{Binding LiveSetting}">
                            <TextBlock Text="{Binding Icon}" Classes="icone"
                                       Classes.feito="{Binding IsDone}" Classes.pendente="{Binding IsPending}" Classes.falhou="{Binding IsFailed}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Texto2}" FontSize="15"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border IsVisible="{Binding IsWorking}" BorderBrush="{DynamicResource Acao}" BorderThickness="3,0,0,0" Padding="10,0,0,0">
                      <TextBlock Text="{Binding CurrentActivity}" FontSize="14" Foreground="{DynamicResource Texto2}" TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding CurrentActivity}"
                                 AutomationProperties.LiveSetting="Polite"/>
                    </Border>

                    <!-- Arquivos alterados -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasChangedFiles}">
                      <TextBlock Text="Arquivos criados ou alterados" FontWeight="Bold" FontSize="14"/>
                      <ItemsControl ItemsSource="{Binding ChangedFiles}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="secondary" Margin="0,0,8,8" FontSize="14"
                                    FontFamily="Cascadia Mono, Consolas, monospace"
                                    Content="{Binding Converter={x:Static vm:Ui.FileButton}}"
                                    ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenFileCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Path=., StringFormat=Abrir arquivo {0} na prévia}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <Expander Header="Detalhe técnico" IsVisible="{Binding HasDetail}" FontSize="14">
                      <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="13"
                                           FontFamily="Cascadia Mono, Consolas, monospace"/>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </DockPanel>
  </Grid>

  <!-- ================= Tela "Modelo de IA": ocupa o lugar do chat até a pessoa voltar (Esc também volta) ================= -->
  <DockPanel IsVisible="{Binding IsModelPanelOpen}" Background="{DynamicResource Nevoa}">
    <!-- Cabeçalho fixo: como voltar e o que está em uso agora -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Folha}" BorderBrush="{DynamicResource Linha}"
            BorderThickness="0,0,0,1" Padding="32,16">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <Button Classes="secondary" Content="←  Voltar ao chat" Command="{Binding CloseModelPanelCommand}"
                VerticalAlignment="Center" AutomationProperties.HelpText="Fecha esta tela e volta para a conversa. Atalho Esc."/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Modelo de IA" FontSize="24" FontWeight="Bold"/>
          <TextBlock Classes="muted" Text="Escolha onde a inteligência artificial roda e qual modelo faz o trabalho."/>
        </StackPanel>
        <!-- O que está em uso: ícone num quadrado + nome e modelo, como o cartão da barra lateral -->
        <Border Grid.Column="2" Classes="em-uso" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding ActiveProvider.Name, StringFormat='Em uso agora: {0}'}"
                AutomationProperties.HelpText="{Binding ModelSummary}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Selecao}">
              <TextBlock Text="{Binding ActiveProvider.Icon}" FontSize="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Em uso agora" FontSize="12" Foreground="{DynamicResource Texto2}"/>
              <TextBlock Text="{Binding ActiveProvider.Name}" FontSize="15" FontWeight="Bold"
                         MaxWidth="240" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding ModelSummary}" FontSize="12.5" MaxWidth="240" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding ModelSummary}"
                         FontFamily="Cascadia Mono, Consolas, monospace" Foreground="{DynamicResource Texto2}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Rodapé fixo: a ação principal nunca some da vista -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Folha}" BorderBrush="{DynamicResource Linha}"
            BorderThickness="0,1,0,0" Padding="32,14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="{Binding ProviderMessage}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{Binding ProviderMessage}"/>
          <ProgressBar Height="6" IsIndeterminate="True" IsVisible="{Binding IsConnecting}" MaxWidth="420" HorizontalAlignment="Left"
                       Foreground="{DynamicResource Acao}" Background="{DynamicResource Linha}"
                       AutomationProperties.Name="Conectando"/>
        </StackPanel>
        <Panel Grid.Column="1">
          <Button Classes="primary" MinWidth="240" HorizontalContentAlignment="Center"
                  Content="{Binding ConnectText}" Command="{Binding ConnectProviderCommand}"
                  IsVisible="{Binding ShowConnect}" IsEnabled="{Binding !IsConnecting}"/>
          <Button Classes="primary" MinWidth="240" HorizontalContentAlignment="Center"
                  Content="Pronto, voltar ao chat" Command="{Binding CloseModelPanelCommand}"
                  IsVisible="{Binding !ShowConnect}"/>
        </Panel>
      </Grid>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="960" Margin="32,24,32,32" Spacing="18">

        <!-- Etapa 1: onde a IA roda -->
        <Border Classes="etapa">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="numero"><TextBlock Text="1"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="Onde a IA roda"/>
                <TextBlock Classes="muted" Text="No seu computador é grátis e privado. Na internet é mais rápido e precisa de uma chave."/>
              </StackPanel>
            </StackPanel>
            <ListBox Name="ProviderList" Classes="escolha" ItemsSource="{Binding Providers}"
                     SelectedItem="{Binding PickedProvider}" IsEnabled="{Binding !IsConnecting}"
                     AutomationProperties.Name="Onde a inteligência artificial roda">
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" x:DataType="svc:AiProvider">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                  <Setter Property="AutomationProperties.HelpText" Value="{Binding Tag}"/>
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="svc:AiProvider">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                      <Border Grid.Column="2" Classes="etiqueta" Classes.local="{Binding IsLocal}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource Texto2}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <!-- Etapa 2: chave (só para serviços na internet) -->
        <Border Classes="etapa" IsVisible="{Binding NeedsKey}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Classes="numero"><TextBlock Text="2"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="{Binding PickedProvider.Name, StringFormat='Sua chave de {0}'}"/>
                  <TextBlock Classes="muted" Text="É como uma senha que libera o uso do serviço. Você cria no site do provedor."/>
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="Criar uma chave ↗" VerticalAlignment="Center"
                      Command="{Binding OpenKeyPageCommand}"
                      AutomationProperties.HelpText="Abre no navegador a página onde você cria a chave"/>
            </Grid>
            <TextBox Classes="revealPasswordButton" PasswordChar="•" Text="{Binding ApiKeyInput}"
                     PlaceholderText="{Binding KeyPlaceholder}" FontSize="15" MinHeight="48"
                     VerticalContentAlignment="Center" IsEnabled="{Binding !IsConnecting}"
                     AutomationProperties.Name="Chave da API"
                     AutomationProperties.HelpText="{Binding KeyPlaceholder}"/>
            <Border Background="{DynamicResource AvisoSuave}" BorderBrush="{DynamicResource AvisoBorda}"
                    BorderThickness="1" CornerRadius="10" Padding="14,10">
              <TextBlock Text="{Binding PickedPrivacy}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Texto}"/>
            </Border>
            <TextBlock Classes="muted" FontSize="13"
                       Text="🔐  A chave fica guardada criptografada neste computador, só para o seu usuário do Windows."/>
          </StackPanel>
        </Border>

        <!-- Etapa 3: modelo (aparece depois de conectar) -->
        <Border Classes="etapa" IsVisible="{Binding ShowModelPicker}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="numero"><TextBlock Text="{Binding ModelStepNumber}"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="Qual modelo faz o trabalho"/>
                <TextBlock Classes="muted" Text="{Binding ModelHint}"/>
              </StackPanel>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ModelFilter}" PlaceholderText="🔍  Procurar modelo pelo nome"
                       FontSize="15" MinHeight="48" VerticalContentAlignment="Center"
                       AutomationProperties.Name="Procurar modelo pelo nome"/>
              <Button Grid.Column="1" Classes="secondary" Content="⟳  Atualizar"
                      Command="{Binding RefreshModelsCommand}"
                      AutomationProperties.Name="Atualizar lista de modelos"/>
            </Grid>
            <ListBox Classes="escolha" ItemsSource="{Binding FilteredModels}" SelectedItem="{Binding PickedModel}"
                     MaxHeight="340" AutomationProperties.Name="Modelos disponíveis">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13.5"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="muted" FontSize="13" Text="{Binding ModelCountText}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </Panel>
  </DockPanel>
</Window>
